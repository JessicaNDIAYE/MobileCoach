{
  "expo": {
    "name": "Nutrika",
    "slug": "nutrika",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jessicandiaye.nutrika",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F3EADA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jessicandiaye.nutrika",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Nutrika accède à tes photos pour enregistrer tes plats et tickets de caisse.",
          "cameraPermission": "Nutrika utilise l'appareil photo pour scanner tes tickets et photographier tes plats."
        }
      ]
    ],
    "scheme": "nutrika",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c4b059c5-a832-4675-8b48-dceb51eb4d8a"
      }
    },
    "owner": "ndjsn11",
    "updates": {
      "url": "https://u.expo.dev/c4b059c5-a832-4675-8b48-dceb51eb4d8a"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
